{
  "name": "agent-cli",
  "version": "0.1.0",
  "private": true,
  "description": "具备工作区工具与图片生成能力的交互式 Agent CLI",
  "type": "module",
  "bin": {
    "agent-cli": "./dist/main.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm build:web && tsx src/web/main.ts",
    "dev:cli": "tsx src/main.tsx",
    "build": "pnpm build:web && tsc -p tsconfig.build.json",
    "build:web": "node scripts/buildWeb.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/web/main.js",
    "start:cli": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "dotenv": "^16.6.1",
    "ink": "^6.4.0",
    "ink-text-input": "^6.0.0",
    "openai": "^6.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "wrap-ansi": "^9.0.0",
    "yargs": "^18.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.25.12",
    "ink-testing-library": "^4.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
