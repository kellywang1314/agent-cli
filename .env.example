# 填入本地密钥；不要将 .env 提交到仓库。
AIDP_API_KEY=
AIDP_MODEL=gpt-5.5-2026-04-24
AIDP_IMAGE_MODEL=gpt-image-2
# 完整聊天端点；不要追加 /openai/chat/completions。
AIDP_CHAT_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl
AIDP_IMAGE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl/openai/images/generations

# 可选：覆盖本地会话与记忆数据库路径。
# macOS 默认：~/Library/Application Support/agent-cli/agent.db
# 数据库可能包含脱敏后的对话和代码片段，请勿上传或提交。
# AGENT_CLI_DB_PATH=/absolute/path/to/agent.db

# 可选：启用 Redis 记忆缓存；SQLite 始终是持久化真相源。
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_CACHE_TTL_SECONDS=300
